FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy pyproject.toml and README.md first to leverage Docker caching
COPY pyproject.toml README.md ./

# Create src package skeleton so editable install works
RUN mkdir -p src/config src/storage src/enforcement src/detection src/metrics src/proxy src/backend

# Install package dependencies
RUN pip install --no-cache-dir -e .

# Copy remaining source code
COPY src/ ./src/
COPY config/ ./config/

EXPOSE 8000

# Run rate limiter proxy
CMD ["uvicorn", "src.proxy.app:app", "--host", "0.0.0.0", "--port", "8000"]
